# Salin file ini jadi ".env" dan isi dengan data Anda sendiri
# JANGAN commit file .env yang sudah diisi ke Git/publik manapun

# --- Facebook (WAJIB) ---
FB_PAGE_ID=isi_page_id_anda
FB_PAGE_ACCESS_TOKEN=isi_long_lived_page_token_anda

# --- Background video otomatis (GRATIS, opsional tapi disarankan) ---
# Daftar gratis di https://www.pexels.com/api/ untuk dapat API key
PEXELS_API_KEY=isi_pexels_api_key_gratis_anda

# --- Opsional: HANYA jika ingin variasi narasi baru via Claude API (berbayar) ---
# Kalau dikosongkan, sistem tetap jalan 100% gratis pakai bank narasi lokal (content_bank.py)
ANTHROPIC_API_KEY=
USE_AI_VARIATION=false

# --- Pengaturan video ---
VIDEO_LANG=id
